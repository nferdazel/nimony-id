#!/usr/bin/env sh
#
# nimony-id — single entry point for the book.
#
#   ./task build    render the English and Indonesian books with Quarto
#   ./task verify   compile and run every sample at the pinned toolchain
#   ./task check    verify then build (the gate before a commit)
#   ./task version  print the book version from VERSION
#   ./task release  bump VERSION from the commit log, commit it, and tag
#   ./task help
#
# Plain POSIX shell, same pattern as nim-id: no extra tooling.
#
# The editorial frontmatter in chapters/NN-slug/{en,id}.md is not valid Quarto
# YAML (tech_review carries an unquoted colon), so build stages copies with the
# frontmatter stripped into .build/<lang> and renders one Quarto project per
# language there. Sources are not modified.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT"

usage() {
  cat <<'TXT'
usage: ./task <command>

  build   render the English and Indonesian books with Quarto
  verify  compile and run every sample at the pinned toolchain
  check   verify then build
  version print the book version (from VERSION)
  release bump the version from commit messages, then commit and tag
          (--major / --minor / --patch, --skip-check)
  help    show this message

environment:
  QUARTO      path to the quarto binary (default: quarto on PATH,
              then $HOME/.local/opt/bin/quarto)
  NIMONY_HOME fixed toolchain install (default: $HOME/.local/opt/nimony/4ba90a7)
TXT
}

quarto_bin() {
  if [ -n "${QUARTO:-}" ]; then
    printf '%s\n' "$QUARTO"
  elif command -v quarto >/dev/null 2>&1; then
    command -v quarto
  elif [ -x "$HOME/.local/opt/bin/quarto" ]; then
    printf '%s\n' "$HOME/.local/opt/bin/quarto"
  else
    echo "requires 'quarto' on PATH, or set QUARTO=/path/to/quarto" >&2
    exit 1
  fi
}

verify() {
  found=$(find samples -mindepth 2 -maxdepth 2 -name '*.nim' -print -quit)
  if [ -z "$found" ]; then
    echo "no sample files under samples/*/*.nim; refusing to report a green verify" >&2
    exit 1
  fi
  bash tools/verify-samples.sh
}

stage_book() {
  lang=$1
  stage="$ROOT/.build/$lang"
  rm -rf "$stage"
  mkdir -p "$stage/chapters"
  # The preface follows the edition; index.qmd stays the fallback.
  preface="$ROOT/index.$lang.qmd"
  [ -f "$preface" ] || preface="$ROOT/index.qmd"
  cp "$preface" "$stage/index.qmd"
  # Same chapter list for both editions, retargeted at this language.
  sed -e "s|/en\.md\$|/$lang.md|" \
      -e "s|^lang: en\$|lang: $lang|" \
      -e "s|^  language: en\$|  language: $lang|" \
      "$ROOT/_quarto.yml" > "$stage/_quarto.yml"
  for src in "$ROOT"/chapters/*/"$lang".md; do
    [ -f "$src" ] || continue
    slug=$(basename -- "$(dirname -- "$src")")
    mkdir -p "$stage/chapters/$slug"
    strip_frontmatter "$src" > "$stage/chapters/$slug/$lang.md"
  done
}

strip_frontmatter() {
  awk 'NR == 1 && $0 == "---" { front = 1; next }
       front == 1 && $0 == "---" { front = 0; next }
       front != 1 { print }' "$1"
}

# The bilingual policy in executable form: every chapter folder must carry both
# en.md and id.md, or the build refuses to run.
require_pairs() {
  missing=0
  pairs=0
  for dir in "$ROOT"/chapters/*/; do
    [ -d "$dir" ] || continue
    slug=$(basename -- "$dir")
    if [ -f "$dir/en.md" ] && [ ! -f "$dir/id.md" ]; then
      echo "chapters/$slug has en.md but no id.md; the book is bilingual, both are required" >&2
      missing=1
    elif [ -f "$dir/id.md" ] && [ ! -f "$dir/en.md" ]; then
      echo "chapters/$slug has id.md but no en.md; the book is bilingual, both are required" >&2
      missing=1
    elif [ -f "$dir/en.md" ]; then
      pairs=$((pairs + 1))
    fi
  done
  if [ "$pairs" -eq 0 ]; then
    echo "no chapter pairs under chapters/*/; refusing to render an empty book" >&2
    missing=1
  fi
  [ "$missing" -eq 0 ] || exit 1
}

build() {
  require_pairs
  q=$(quarto_bin)
  stage_book en
  stage_book id
  ( cd "$ROOT/.build/en" && "$q" render )
  ( cd "$ROOT/.build/id" && "$q" render )
  rm -rf "$ROOT/_book"
  mkdir -p "$ROOT/_book/en" "$ROOT/_book/id"
  cp -R "$ROOT/.build/en/_book/." "$ROOT/_book/en/"
  cp -R "$ROOT/.build/id/_book/." "$ROOT/_book/id/"
}

case "${1:-help}" in
  build)
    build
    ;;
  verify)
    verify
    ;;
  check)
    require_pairs
    verify
    build
    ;;
  version)
    tr -d '[:space:]' < "$ROOT/VERSION"
    echo
    ;;
  release)
    if [ "$#" -gt 0 ]; then shift; fi
    sh "$ROOT/tools/release.sh" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "unknown command: $1" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
