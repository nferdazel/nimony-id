#!/usr/bin/env sh
#
# nimony-id — single entry point for the book.
#
#   ./task build    render both editions and both PDFs into public/
#   ./task verify   compile and run every sample at the pinned toolchain
#   ./task check    verify then build (the gate before a commit)
#   ./task version  print the book version from VERSION
#   ./task release  bump VERSION from the commit log, commit it, and tag
#   ./task help
#
# Plain POSIX shell, same pattern as nim-id: no extra tooling.
#
# The editorial frontmatter in chapters/NN-slug/{en,id}.md is not valid Quarto
# YAML (tech_review carries an unquoted colon), so tools/build-site.sh stages
# copies with the frontmatter stripped into .build/<lang> and renders one
# Quarto project per language there. Sources are not modified.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT"

usage() {
  cat <<'TXT'
usage: ./task <command>

  build   render both editions and both PDFs into public/
  verify  compile and run every sample at the pinned toolchain
  check   verify then build
  version print the book version (from VERSION)
  release bump the version from commit messages, then commit and tag
          (--major / --minor / --patch, --skip-check)
  help    show this message

environment:
  QUARTO      path to the quarto binary (default: quarto on PATH,
              then $HOME/.local/opt/bin/quarto); must be 1.10.19
  NIMONY_HOME fixed toolchain install (default: $HOME/.local/opt/nimony/4ba90a7)
TXT
}

quarto_bin() {
  if [ -n "${QUARTO:-}" ]; then
    printf '%s\n' "$QUARTO"
  elif command -v quarto >/dev/null 2>&1; then
    command -v quarto
  elif [ -x "$HOME/.local/opt/bin/quarto" ]; then
    printf '%s\n' "$HOME/.local/opt/bin/quarto"
  else
    echo "requires 'quarto' on PATH, or set QUARTO=/path/to/quarto" >&2
    exit 1
  fi
}

verify() {
  found=$(find samples -mindepth 2 -maxdepth 2 -name '*.nim' -print -quit)
  if [ -z "$found" ]; then
    echo "no sample files under samples/*/*.nim; refusing to report a green verify" >&2
    exit 1
  fi
  bash tools/verify-samples.sh
}

build() {
  QUARTO="$(quarto_bin)" bash tools/build-site.sh
}

case "${1:-help}" in
  build)
    build
    ;;
  verify)
    verify
    ;;
  check)
    verify
    build
    ;;
  version)
    tr -d '[:space:]' < "$ROOT/VERSION"
    echo
    ;;
  release)
    if [ "$#" -gt 0 ]; then shift; fi
    sh "$ROOT/tools/release.sh" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "unknown command: $1" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
