# Caddyfile.nimony-id.example — blok Caddy untuk situs buku di nimony.qouver.com.
#
# Ini CERMIN dari blok yang hidup di /etc/caddy/Caddyfile (sumber kebenaran di server).
# Kalau blok di server berubah, ubah berkas ini di commit yang sama.
#
# Situs ini statis saja: tidak ada container, tidak ada image, tidak ada tag :local/:prev.
# Yang dipakai dari kontrak deploy: ref-guard fail-closed, flock, fetch/reset, health check.
#
# Nama snippet di sini mengikuti qouver1, bukan qouver0: host ini mendefinisikan
# `cf_aop` (Origin CA + Authenticated Origin Pulls), `logging`, `security`,
# `block_dotfiles`, dan satu snippet handler per situs. `log_access` dan
# `base_security_headers` hanya ada di qouver0 dan membuat `caddy validate` gagal di sini.

# ── handler situs: Quarto book ────────────────────────────────────────────────

(app_nimony) {
	encode zstd gzip
	import block_dotfiles

	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	# Hasil render Quarto. `deploy-static.sh` yang mengisi direktori ini.
	root * /srv/qouver/apps/nimony-id/web
	try_files {path} {path}.html
	file_server

	# Halaman 404 yang bisa dibaca. Tanpa blok ini, alamat yang salah dibalas
	# badan kosong: pembaca tidak tahu apa yang terjadi dan tidak punya jalan pulang.
	handle_errors {
		import security
		@notfound expression {http.error.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}

	# Font dan gambar jarang berubah: cache panjang.
	@font path /fonts/* *.woff2
	header @font Cache-Control "public, max-age=2592000, immutable"
	@gambar path *.svg *.png *.jpg *.webp
	header @gambar Cache-Control "public, max-age=604800"

	# CSS dan JS memakai nama berkas tetap (Quarto tidak memberi hash), jadi jangan
	# di-cache lama: tanpa ini, Cloudflare menyajikan CSS lama sampai 30 hari setelah deploy
	# dan tampilan Indonesia tertinggal dari English.
	@skrip path *.css *.js
	header @skrip Cache-Control "public, max-age=300, must-revalidate"

	# HTML selalu revalidasi.
	@lain not path /fonts/* *.woff2 *.css *.js *.svg *.png *.jpg *.webp *.pdf
	header @lain Cache-Control "no-cache"

	# PDF rilis: jangan di-cache lama, supaya versi baru langsung terlihat.
	@pdf path *.pdf
	header @pdf Cache-Control "public, max-age=300"
}

# ── blok situs ────────────────────────────────────────────────────────────────

nimony.qouver.com {
	import cf_aop
	import logging
	import security
	import app_nimony
}
